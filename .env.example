# Copy to .env for local development. Do not commit .env or production secrets.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://coyote:localdev-only@localhost:5432/coyote_mcp
SESSION_SECRET_KEY=development-only-change-me

# Register this exact callback URI with the enterprise OIDC provider.
OIDC_ISSUER=https://login.example.com
OIDC_CLIENT_ID=replace-with-client-id
OIDC_CLIENT_SECRET=replace-with-client-secret
OIDC_REDIRECT_URI=http://localhost:8000/auth/oidc/callback
OIDC_ALLOWED_ORGANIZATION=
OIDC_GROUP_CLAIM=groups
OIDC_TRUSTED_ENDPOINT_HOSTS=[]
OIDC_JIT_PROVISIONING_ENABLED=false

# Phase 4C downstream credentials (optional; required for shared credentials and
# per-user OAuth). Uncomment and set before use.
# COYOTE_CREDENTIAL_ENCRYPTION_KEYS={"v1": "replace-with-base64url-32-byte-key"}
# COYOTE_CREDENTIAL_ACTIVE_KEY_VERSION=v1
# Local GitHub OAuth development only: register this exact callback URI with the
# OAuth App and set ALLOW_INSECURE_ENDPOINTS=true. HTTP is accepted only for
# localhost, 127.0.0.1, or ::1 while ENVIRONMENT=development.
# COYOTE_DOWNSTREAM_OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# ALLOW_INSECURE_ENDPOINTS=true
# COYOTE_DOWNSTREAM_OAUTH_TIMEOUT_SECONDS=10
